{
  "name": "firefly-picture-books",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "voice": "python3 tools/build_voice.py",
    "art": "python3 tools/placeholder_art.py",
    "test": "node --test \"tests/*.test.mjs\" && python3 -m unittest discover -s tools -p \"test_*.py\"",
    "check": "python3 tools/check_book.py --all",
    "test:e2e": "vite build && node tests/e2e/smoke.mjs",
    "fonts": ".venv/bin/python tools/build_fonts.py"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^6.4.3"
  }
}
